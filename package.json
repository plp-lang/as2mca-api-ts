{
  "name": "as2mca-api",
  "version": "0.3.0",
  "description": "Aplication Server 2MCA API HTTP Client",
  "keywords": [
    "2mca",
    "abs",
    "api",
    "async",
    "cbs",
    "cft",
    "client",
    "http",
    "node",
    "sdk",
    "typescript"
  ],
  "homepage": "https://github.com/plp-lang/as2mca-api-ts",
  "bugs": {
    "url": "https://github.com/plp-lang/as2mca-api-ts/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Falldot",
    "email": "fe.offep@gmail.com",
    "url": "https://github.com/Falldot"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plp-lang/as2mca-api-ts.git"
  },
  "publisher": "Falldot",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "browser": "./dist/browser/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "bunup --watch",
    "build": "bun update && bun lint:fix && bun fmt:fix && bun test && bun bunup",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "upgrade": "bunx npm-check-updates -u && bun update",
    "release": "bun lint:fix && bun fmt:fix && bun test && bun run build && npm publish"
  },
  "dependencies": {
    "fast-xml-builder": "^1.3.0",
    "fast-xml-parser": "^5.10.1",
    "fetch-cookie": "^3.2.0",
    "tough-cookie": "^6.0.2"
  },
  "devDependencies": {
    "@logtape/logtape": "^2.3.0",
    "@logtape/pretty": "^2.3.0",
    "@types/bun": "^1.3.14",
    "bunup": "^0.16.32",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  }
}
